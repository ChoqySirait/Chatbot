# Environment configuration template for SecurAI
# Copy this file to .env and fill in values locally. Never commit .env to Git.

ENVIRONMENT=development
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-2.5-flash
REQUEST_TIMEOUT_SECONDS=8.0
RATE_LIMIT_PER_MINUTE=120
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
